<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_membership_line_list" model="ir.ui.view">
        <field name="name">membership.line.list</field>
        <field name="model">membership.membership_line</field>
        <field name="arch" type="xml">
            <list string="Membership">
                <field name="date" />
                <field name="date_from" optional="show" />
                <field name="date_to" optional="show" />
                <field name="date_cancel" optional="hide" />
                <field name="membership_id" />
                <field name="category_id" optional="hide" />
                <field name="member_price" />
                <field name="account_invoice_id" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record id="view_membership_line_form" model="ir.ui.view">
        <field name="name">membership.line.form</field>
        <field name="model">membership.membership_line</field>
        <field name="arch" type="xml">
            <form string="Membership">
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        options="{'clickable': 1}"
                        statusbar_colors='{
                            "none": "red",
                            "canceled": "red",
                            "old": "yellow",
                            "waiting": "yellow",
                            "invoiced": "yellow",
                            "free": "green",
                            "done": "green",
                        }'
                        statusbar_visible="canceled,old,waiting,invoiced,free,done"
                    />
                </header>

                <sheet>
                    <widget
                        name="web_ribbon_archived"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active"
                    />

                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="membership_id"
                                readonly="account_invoice_id"
                                context="{
                                    'default_membership': True,
                                    'default_detailed_type': 'service',
                                    'form_view_ref': 'membership.membership_products_form'
                                }"
                            />
                        </h1>
                    </div>

                    <group name="main">
                        <group name="left">
                            <field name="category_id" />
                            <field name="member_price" readonly="account_invoice_id" />
                            <field
                                name="account_invoice_id"
                                invisible="not account_invoice_id"
                            />
                        </group>
                        <group string="Dates" name="dates">
                            <group>
                                <field name="date" required="1" />
                                <field name="date_from" required="1" />
                                <field name="date_to" required="1" />
                                <field name="date_cancel" />
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
